# Copy to .env for local development. Real environment variables override .env.

# Django
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vite dev server origin, so CSRF-protected requests proxied from React are accepted.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep false for local HTTP. Set true when served over HTTPS (Secure session/CSRF cookies).
DJANGO_SECURE_COOKIES=false

# PostgreSQL (compose.yaml also uses these to initialise the container)
DB_NAME=roshan_rozgar
DB_USER=roshan_rozgar
DB_PASSWORD=local-dev-password
DB_HOST=127.0.0.1
# Use another port (e.g. 5433) if a native PostgreSQL already listens on 5432.
DB_PORT=5432

# Worker ID-card OCR. "mock" (default) uses built-in fictional fixtures and needs no network.
# "live" posts the image server-side to OCR_ENDPOINT; the key never reaches the browser.
OCR_MODE=mock
OCR_ENDPOINT=
OCR_API_KEY=
OCR_API_KEY_HEADER=X-API-Key
OCR_IMAGE_FIELD=image
OCR_TEXT_FIELD=text
OCR_TIMEOUT_SECONDS=10
